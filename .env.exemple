PORT=3306

MYSQL_JDBC_URL=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

MYSQL_CONNECT_TIMEOUT=20000
MYSQL_CONNECT_RETRIES=2
MYSQL_POOL_LIMIT=5

CACHE_SECONDS=300
REMANEJAMENTO_LISTA_LIMIT=100

DASHBOARD_SAUDE_INDIGENA_URL=
DASHBOARD_FERIAS_URL=

# Autenticação (sessão JWT)
JWT_SECRET=troque-por-um-segredo-forte
JWT_EXPIRES=8h

# Rate limiting (proteção contra DoS / força bruta)
# TRUST_PROXY: nº de proxies reversos à frente (1 = um proxy; 0 = acesso direto).
TRUST_PROXY=1
# Limite geral da API: máx. de requisições por IP na janela (ms).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
# Limite específico do login (mais rígido contra força bruta).
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=20

# Usuário administrador inicial (criado apenas se a tabela de usuários estiver vazia).
# É criado como super administrador (nível 3): pode conceder/retirar privilégios
# e excluir usuários do sistema, além de tudo que o administrador comum faz.
SEED_ADMIN_LOGIN=admin
SEED_ADMIN_SENHA=AgSUS@2026
SEED_ADMIN_NOME=Administrador
SEED_ADMIN_EMAIL=

# Níveis de autorização (opcionais — use os padrões abaixo se não souber):
#   1 = usuário comum · 2 = administrador (aprova/recusa acesso, salva remanejamento)
#   3 = super administrador (concede privilégios e exclui usuários do sistema)
# NIVEL_ADMIN=2
# NIVEL_SUPERADMIN=3

# Login com Google (OAuth 2.0 / OpenID Connect)
# GOOGLE_CLIENT_ID: Client ID do tipo "Web application" criado no Google Cloud Console.
#   Sem este valor, o botão "Entrar com Google" não aparece (login por senha continua).
# GOOGLE_ALLOWED_DOMAIN: domínios permitidos, separados por vírgula (vazio = qualquer).
#   Ex.: agenciasus.org.br,parceiro.org.br,gmail.com
# GOOGLE_ALLOWED_EMAILS: e-mails liberados individualmente (separados por vírgula),
#   independente do domínio. Ideal para pessoas externas pontuais / usuários de teste.
#   Ex.: fulano@gmail.com,ciclano@outro.org
GOOGLE_ALLOWED_EMAILS=
# GOOGLE_NIVEL_PADRAO: nível atribuído a um usuário Google novo (auto-cadastro). Padrão: 1
GOOGLE_CLIENT_ID=
GOOGLE_ALLOWED_DOMAIN=agenciasus.org.br
GOOGLE_NIVEL_PADRAO=1